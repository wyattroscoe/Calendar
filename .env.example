# Copy to .env for local development. Never commit .env.
# On Vercel, set these under Project → Settings → Environment Variables.

# The password for signing in.
APP_PASSWORD=

# Random string, 32+ characters, used to sign the login cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string. Leave blank locally to use the built-in PGlite database.
# Vercel fills this in automatically when you add a Neon database.
DATABASE_URL=

# Your time zone, used to decide what "today" is.
APP_TIMEZONE=America/Los_Angeles
